# ─────────────────────────────────────────────────────────────
#  TreeScape — varijable okruženja
#  Kopiraj ovu datoteku u `.env.local` i popuni prave vrijednosti.
#  `.env.local` se NIKADA ne commita na GitHub.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role ključ — SAMO server. Nikada ga ne stavljaj u NEXT_PUBLIC_ varijablu.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Stripe ──────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys (koristi test ključeve za razvoj)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dobiješ ga iz `stripe listen` (lokalno) ili Dashboard → Webhooks (produkcija)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Admin pristup ───────────────────────────────────────────
# Tajni kod kojim vlasnik otključava /admin. Neka bude dug i nasumičan.
ADMIN_ACCESS_CODE=promijeni-me-u-dug-nasumican-kod
# Tajna za potpisivanje admin kolačića. Generiši: openssl rand -base64 32
ADMIN_SESSION_SECRET=promijeni-me-najmanje-32-znaka-duga-tajna

# ── Cron ────────────────────────────────────────────────────
# Štiti /api/cron/expire-holds. Generiši: openssl rand -hex 32
CRON_SECRET=promijeni-me

# ── Aplikacija ──────────────────────────────────────────────
# Puni URL sajta, bez kose crte na kraju. Lokalno: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (opcionalno) ──────────────────────────────────────
# Ako ostaviš prazno, aplikacija radi normalno — samo ne šalje mailove.
RESEND_API_KEY=
# Adresa s koje se šalju mailovi (mora biti verifikovan domen u Resend-u)
EMAIL_FROM=TreeScape <rezervacije@tvoj-domen.ba>
# Vlasnikova adresa — tu stižu obavijesti o novim rezervacijama
OWNER_EMAIL=vlasnik@primjer.ba
