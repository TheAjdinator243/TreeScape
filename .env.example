# ─────────────────────────────────────────────────────────────
#  TreeScape — varijable okruženja
#  Kopiraj ovu datoteku u `.env.local` i popuni prave vrijednosti.
#  `.env.local` se NIKADA ne commita na GitHub.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role ključ — SAMO server. Nikada ga ne stavljaj u NEXT_PUBLIC_ varijablu.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Plaćanje ────────────────────────────────────────────────
# Bankovni podaci (IBAN, naziv primaoca) se NE drže ovdje nego u
# administraciji: /admin → Cijene → "Podaci za uplatu na račun".
# Tako ih vlasnik mijenja sam, bez diranja koda i bez ponovne objave.
#
# TEST način plaćanja: potvrđuje rezervaciju bez ijednog pravog centa.
# Služi da se cijeli tok isproba. NIKADA ga ne ostavljaj na "true" na
# pravom sajtu — svako bi mogao rezervisati besplatno.
ENABLE_TEST_PAYMENTS=false

# ── Admin pristup ───────────────────────────────────────────
# Tajni kod kojim vlasnik otključava /admin. Neka bude dug i nasumičan.
ADMIN_ACCESS_CODE=promijeni-me-u-dug-nasumican-kod
# Tajna za potpisivanje admin kolačića. Generiši: openssl rand -base64 32
ADMIN_SESSION_SECRET=promijeni-me-najmanje-32-znaka-duga-tajna

# ── Cron ────────────────────────────────────────────────────
# Štiti /api/cron/expire-holds. Generiši: openssl rand -hex 32
CRON_SECRET=promijeni-me

# ── Aplikacija ──────────────────────────────────────────────
# Puni URL sajta, bez kose crte na kraju. Lokalno: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (opcionalno) ──────────────────────────────────────
# Ako ostaviš prazno, aplikacija radi normalno — samo ne šalje mailove.
RESEND_API_KEY=
# Adresa s koje se šalju mailovi (mora biti verifikovan domen u Resend-u)
EMAIL_FROM=TreeScape <rezervacije@tvoj-domen.ba>
# Vlasnikova adresa — tu stižu obavijesti o novim rezervacijama
OWNER_EMAIL=vlasnik@primjer.ba

# ── Telegram (opcionalno, ali preporučeno) ──────────────────
# Obavijest o novom zahtjevu koja stigne na telefon za koju sekundu.
# Zahtjev za gotovinu drži termin samo neko vrijeme, pa je bitno da
# vlasnik sazna odmah — mail zna kasniti i završiti u promocijama.
#
# Kako se dobiju ove dvije vrijednosti (traje 2 minute, besplatno je):
#   1) U Telegramu potraži @BotFather → /newbot → dobiješ TOKEN
#   2) Napiši svom novom botu bilo šta (npr. "zdravo") — dok mu ne
#      napišeš prvi, bot ti ne smije slati poruke
#   3) Otvori: https://api.telegram.org/bot<TOKEN>/getUpdates
#      i prepiši broj iz "chat":{"id": ... }
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
